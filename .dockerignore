# Keep the build context small. Without this, `docker build` uploads the entire
# data directory — several gigabytes of IBTrACS CSV and Parquet — before the
# first instruction runs.
data/

# models/ is NOT excluded: Dockerfile.deploy copies the XGBoost artifacts in.
# Excluding it here would produce an image that starts up and reports
# "degraded" with no obvious cause.

reports/figures/
reports/logs/
.git/
.venv/
.venv_*/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
tests/
notebooks/
*.md
!README.md